# Server Configuration
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/ivr_system_prod
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-in-production-minimum-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Twilio Configuration (Optional - for cloud telephony)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AWS Configuration (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ivr-audio-files-prod

# Application URLs (Update with your domain)
BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
WEBSOCKET_URL=wss://your-domain.com:8080

# File Upload
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# Rate Limiting (Production settings)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security
WEBHOOK_SECRET=your-webhook-secret-key-change-this
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-minimum-32-characters

# SSL Configuration (for HTTPS)
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Monitoring & Health Checks
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
PERFORMANCE_MONITORING=true

# Android App Configuration
ANDROID_WEBSOCKET_PORT=8080
ANDROID_WEBSOCKET_SECURE=true